; Контракты границ модулей монолита (ADR-002, раздел 3.5). Запуск: `make arch` (lint-imports).
; Контракты 4–7 действуют всегда; контракты 1–3 перечисляют модули реестра и генерируются
; скаффолдером (`make scaffold-module name=<module>`) в блоке ниже — вручную блок не правится.

[importlinter]
root_packages =
    app
    configs
; Нужно контрактам 5 и 7: внешние пакеты redis, aioboto3, botocore, opensearchpy, qdrant_client.
include_external_packages = True

; 4. Shared kernel и configs не знают о модулях.
[importlinter:contract:core-does-not-import-modules]
name = app.core и configs не импортируют app.modules
type = forbidden
source_modules =
    app.core
    configs
forbidden_modules =
    app.modules

; 5. Доступ к Redis — только через обёртку shared kernel с префиксом модуля (ADR-003).
[importlinter:contract:redis-only-via-module-redis]
name = Модули не используют пакет redis и общий Redis-клиент напрямую
type = forbidden
source_modules =
    app.modules
forbidden_modules =
    redis
    app.core.dao.caching.redis_conn
allow_indirect_imports = True

; 6. Публикация в Kafka — только через outbox (ADR-004); брокер процесса модулям недоступен.
[importlinter:contract:kafka-publish-only-via-outbox]
name = Модули не импортируют брокер Kafka; публикация только через OutboxPublisher
type = forbidden
source_modules =
    app.modules
forbidden_modules =
    app.core.kafka.broker
allow_indirect_imports = True

; 7. Клиенты внешних хранилищ — только через обёртки shared kernel (ADR-007, ADR-014).
[importlinter:contract:storage-clients-only-via-core]
name = Модули не импортируют aioboto3, botocore, opensearchpy, qdrant_client
type = forbidden
source_modules =
    app.modules
forbidden_modules =
    aioboto3
    botocore
    opensearchpy
    qdrant_client
allow_indirect_imports = True

; >>> modules: contracts 1-3 (generated by `python -m cli add-module`)

; 1. Модули независимы; разрешён только публичный API соседа.
[importlinter:contract:modules-public-api-only]
name = Доменные модули независимы, кроме импортов из public
type = independence
modules =
    app.modules.identity
ignore_imports =
    app.modules.** -> app.modules.*.public
    app.modules.** -> app.modules.*.public.**
unmatched_ignore_imports_alerting = none

; 2. Направление зависимостей между модулями — по реестру (карта SYS-01): верхние могут
;    импортировать public нижних, но не наоборот; циклы между модулями запрещены.
[importlinter:contract:modules-dependency-order]
name = Зависимости между модулями направлены по карте модулей SYS-01
type = layers
containers =
    app.modules
layers =
    identity
exhaustive = true
exhaustive_ignores =
    registry

; 3. Слои внутри каждого модуля — как в boilerplate (отсутствующий слой допустим).
[importlinter:contract:module-internal-layers]
name = Слои внутри модуля: api и brokers -> public -> services -> dao -> models
type = layers
containers =
    app.modules.identity
layers =
    (api) | (brokers)
    (public)
    (services)
    (dao)
    (models)
; <<< modules

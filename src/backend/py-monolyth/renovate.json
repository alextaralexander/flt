{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "description": "Автообновление зависимостей: pyproject (pep621+uv), pre-commit, Dockerfile, CI.",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["faststream"],
      "description": "0.7 — breaking migration, делается вручную вместе с py-main-lib",
      "allowedVersions": "<0.7"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "groupName": "dev tooling"
    }
  ]
}

# Оверлей для ЛОКАЛЬНОГО запуска pytest (pytest подхватывает через env_files в pyproject.toml).
# Тесты идут на стенде local (STAND_NAME здесь НЕ задаётся) — этот файл только
# переопределяет/дополняет его. Не путать с envs/test/ — это конфигурация
# ДЕПЛОЙ-стенда test, к pytest она отношения не имеет.
# Переменные окружения (например, из CI) имеют приоритет над этим файлом.

# Защита от запуска тестов на реальной БД: фикстура миграций проверяет этот флаг.
TEST_MODE=true

# Ключ подписи JWT для pytest (не секрет, только для тестов) и токен пользователя
# `testadmin` (USER_ID = ...002, роль ADMIN, все permissions примера, exp — 2100 год),
# подписанный этим ключом. HTTP/no_db-тесты подменяют аутентификацию (conftest),
# но токен проходит и реальную локальную проверку `check_token`.
JWT_SECRET_KEY=pytest-jwt-secret-not-for-production-0123456789
JWT_ALGORITHM=HS256
TEST_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..kPwQKyWrBp85rHG32TF9wiuFzdx4zem53d4CJEY9ybw
TEST_USER_ID=00000000-0000-0000-0000-000000000002

# Postgres тестовой БД
PG_USERNAME=ms_py_test
PG_PASSWORD=ms_py_test
PG_DATABASE=flt

# OpenSearch в тестах выключен
OPEN_SEARCH_LOGS_ENABLED=false
OPEN_SEARCH_VERIFY_SSL=false
OPEN_SEARCH_URL=http://127.0.0.1:9200
OPEN_SEARCH_USER_NAME=""
OPEN_SEARCH_PASSWORD=""

# В тестах не экспортируем трейсы (иначе OTLP-экспортер шумит ошибками подключения).
OTLP_EXPORTER_ENDPOINT=

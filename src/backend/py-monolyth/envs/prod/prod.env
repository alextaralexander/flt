# FastAPI App settings
FAST_API_HOST=0.0.0.0
FAST_API_PORT=8000
DEBUG_MODE=false

# Postgres settings.
# PG_USERNAME/PG_PASSWORD на проде НЕ задаются в env-файле:
# их отдаёт Vault (configs/vault_config.py) или переменные окружения деплоя.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=flt
PG_DRIVER=asyncpg

# Database Engine Settings
POOL_RECYCLE=240
POOL_TIMEOUT=30
POOL_SIZE=10
POOL_MAX_OVERFLOW=5
POOL_PRE_PING=true

# Auth: JWT_SECRET_KEY задаётся Vault-ом или переменной окружения деплоя.
# JWT_ROLE_PERMISSIONS='{"ADMIN": ["GET_MY_ENTITY"]}'

# CORS. Wildcard + credentials браузеры отклоняют — на проде указывай конкретные origin-ы.
ALLOW_ORIGINS='["https://frontend.example.com"]'
ALLOW_CREDENTIALS=True
ALLOW_METHODS='["*"]'
ALLOW_HEADERS='["*"]'

# OpenSearch
OPEN_SEARCH_LOGS_ENABLED=true
OPEN_SEARCH_VERIFY_SSL=true
OPEN_SEARCH_URL=https://127.0.0.1:9200

# Opentelemetry
OTLP_EXPORTER_ENDPOINT=http://127.0.0.1:4317

# Стенд prod: несекретные параметры; адреса — имена сервисов docker-compose / Kubernetes (ADR-013).

# FastAPI App settings
FAST_API_HOST=0.0.0.0
FAST_API_PORT=8000
DEBUG_MODE=false

# Postgres settings. PG_USERNAME и PG_PASSWORD — только переменные окружения
# (.env на VPS или Kubernetes Secret из Vault, ADR-013).
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=flt
PG_DRIVER=asyncpg

# CORS: фронтенд и API отдаются с одного origin через HAProxy (ADR-012), кросс-доменных запросов нет.
ALLOW_ORIGINS='[]'
ALLOW_CREDENTIALS=True
ALLOW_METHODS='["*"]'
ALLOW_HEADERS='["*"]'

# Auth: AUTH_CSRF_SECRET — только переменная окружения (ADR-006, ADR-013).
JWT_ISSUER=flt
JWT_AUDIENCE=flt-api

# OpenTelemetry: экспорт трейсов выключен до этапа 4 (ADR-010).
OTLP_EXPORTER_ENDPOINT=

# FastAPI App settings
FAST_API_HOST=127.0.0.1
FAST_API_PORT=8000
DEBUG_MODE=true

# Postgres settings
PG_USERNAME=ms_py_test
PG_PASSWORD=ms_py_test
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=flt
PG_DRIVER=asyncpg

# Database Engine Settings
POOL_RECYCLE=240
POOL_TIMEOUT=30
POOL_SIZE=10
POOL_MAX_OVERFLOW=5
POOL_PRE_PING=true

# CORS
ALLOW_ORIGINS='["*"]'
ALLOW_CREDENTIALS=True
ALLOW_METHODS='["*"]'
ALLOW_HEADERS='["*"]'

# Auth
# JWT проверяется локально; ключ ниже — только для локальной разработки.
# Токен для ручных запросов: `python -m cli issue-token <user_id> --role ADMIN`.
JWT_SECRET_KEY=local-dev-jwt-secret-change-me-0123456789
JWT_ALGORITHM=HS256
JWT_ROLE_PERMISSIONS='{"ADMIN": ["GET_MY_ENTITY", "GET_MY_ENTITY_LIST", "CREATE_MY_ENTITY", "UPDATE_MY_ENTITY", "DELETE_MY_ENTITY", "GET_SERVICE_INFO", "GET_SYSTEM_METRICS"]}'

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=""
REDIS_PASSWORD=""

# Opensearch (включай, только когда OpenSearch реально поднят — иначе шум в логах)
OPEN_SEARCH_LOGS_ENABLED=false
OPEN_SEARCH_VERIFY_SSL=false
OPEN_SEARCH_URL=https://127.0.0.1:9200
OPEN_SEARCH_USER_NAME="admin"
OPEN_SEARCH_PASSWORD="Local#V9rT2qMx7!"

# Opentelemetry
OTLP_EXPORTER_ENDPOINT=http://localhost:4317

# Стенд local: запуск монолита на машине разработчика (`make dev`) и в docker-compose без .env.
# Значения секретов здесь — только фиксированные тестовые значения локальной инфраструктуры
# (ADR-013, раздел 3.2): они ничего не защищают, кроме локальной машины.

# FastAPI App settings
FAST_API_HOST=127.0.0.1
FAST_API_PORT=8000
DEBUG_MODE=true

# Postgres settings (контейнер postgres из deploy/docker-compose)
PG_USERNAME=ms_py_test
PG_PASSWORD=ms_py_test  # pragma: allowlist secret
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=flt
PG_DRIVER=asyncpg

# Database Engine Settings
POOL_RECYCLE=240
POOL_TIMEOUT=30
POOL_SIZE=10
POOL_MAX_OVERFLOW=5
POOL_PRE_PING=true

# CORS
ALLOW_ORIGINS='["*"]'
ALLOW_CREDENTIALS=True
ALLOW_METHODS='["*"]'
ALLOW_HEADERS='["*"]'

# Auth (ADR-006). Ключи подписи JWT в envs/local не хранятся: для `make dev` их создаёт
# deploy/scripts/gen-secrets.sh в локальный .env, в pytest — одноразовая пара (этап 1 Г.3–Г.5).
AUTH_CSRF_SECRET=local-csrf-secret-not-for-production  # pragma: allowlist secret

# OpenTelemetry: экспорт трейсов выключен до этапа 4 (ADR-010).
OTLP_EXPORTER_ENDPOINT=

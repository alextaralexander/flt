# Хранилище файлов на стенде local: MinIO из deploy/docker-compose (ADR-007, раздел 3.11).
# С хоста — localhost:9000; браузер ходит через HAProxy (после Г.8 — http://flt.localhost).
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_REGION=ru-1
# Тестовые значения стенда local (ADR-013); на остальных стендах — секреты окружения.
S3_ACCESS_KEY=flt_local_minio  # pragma: allowlist secret
S3_SECRET_KEY=flt_local_minio_secret  # pragma: allowlist secret

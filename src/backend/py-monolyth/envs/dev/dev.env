# FastAPI App settings
FAST_API_HOST=127.0.0.1
FAST_API_PORT=8000
DEBUG_MODE=true
ROOT_PATH=/api/flt-ba-as-de-ms-py-my-service

# Postgres settings
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=flt
PG_DRIVER=asyncpg

# Database Engine Settings
POOL_RECYCLE=240
POOL_TIMEOUT=30
POOL_SIZE=10
POOL_MAX_OVERFLOW=5
POOL_PRE_PING=true

# Auth: JWT_SECRET_KEY задаётся Vault-ом или переменной окружения деплоя.
# JWT_ROLE_PERMISSIONS='{"ADMIN": ["GET_MY_ENTITY"]}'

# CORS
ALLOW_ORIGINS='["*"]'
ALLOW_CREDENTIALS=True
ALLOW_METHODS='["*"]'
ALLOW_HEADERS='["*"]'

# OpenSearch
OPEN_SEARCH_LOGS_ENABLED=false
OPEN_SEARCH_VERIFY_SSL=true
OPEN_SEARCH_URL=https://127.0.0.1:9200
OPEN_SEARCH_USER_NAME=""
OPEN_SEARCH_PASSWORD=""

# Opentelemetry
OTLP_EXPORTER_ENDPOINT=http://127.0.0.1:4317

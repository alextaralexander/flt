# Относительные адреса: один и тот же build на всех стендах, маршрутизация через HAProxy (ADR-012)
VITE_APP_API_URL=/api/v1
VITE_APP_WS_URL=/ws
# Моки MSW в браузере вместо бэкенда (только dev)
VITE_APP_ENABLE_API_MOCKING=false
# Служебные страницы этапа 1 (/dev/llm-stream для E2E Г.11); в образе flt-frontend всегда false
VITE_APP_ENABLE_DEV_PAGES=false
# Адрес бэкенда для dev-прокси Vite /api и /ws (не попадает в сборку)
VITE_DEV_BACKEND_URL=http://localhost:8000
# Адрес хранилища для dev-прокси Vite /flt-* (path-style S3, ADR-007; не попадает в сборку)
VITE_DEV_STORAGE_URL=http://localhost:9000
